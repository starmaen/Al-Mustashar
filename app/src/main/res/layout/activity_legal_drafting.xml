<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- شريط الرأس -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ المساعد الذكي لصياغة المذكرات والاستدعاءات"
            android:textColor="#0F2042"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="صياغة استدعاءات إدارية، مذكرات دفاع، ولوائح قضائية رصينة"
            android:textColor="#757575"
            android:textSize="12sp"
            android:gravity="right" />

        <!-- نوع المعاملة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="نوع المذكرة / الاستدعاء:"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <Spinner
            android:id="@+id/spDraftType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- الجهة الموجه إليها -->
        <EditText
            android:id="@+id/etTargetEntity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="الجهة الموجه إليها (مثال: محكمة البداية المدنية / مجلس المدينة)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right" />

        <!-- أطراف العلاقة أو الدعوى -->
        <EditText
            android:id="@+id/etParties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="أطراف العلاقة (المستدعي، الخصم، رقم الأساس إن وجد)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right" />

        <!-- الوقائع والمطالب -->
        <EditText
            android:id="@+id/etFactsAndDemands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="4"
            android:gravity="top|right"
            android:hint="اكتب الوقائع والمطلوب بإيجاز (مثال: طلب بيان وضع عقار وشرح تنظيمي من البلدية، أو مذكرة دفاع وتفنيد شهادة الشهود)..."
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042" />

        <!-- إرفاق صورة مستند مساند -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnAttachImage"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="📎 إرفاق صورة مستند"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#0F2042" />

            <TextView
                android:id="@+id/tvAttachmentStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="لا توجد مرفقات"
                android:textColor="#757575"
                android:textSize="11sp"
                android:gravity="right" />
        </LinearLayout>

        <!-- مؤشر التحميل -->
        <ProgressBar
            android:id="@+id/progressDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- زر توليد المذكرة -->
        <Button
            android:id="@+id/btnGenerateDraft"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="✨ صياغة المذكرة القانونية الآن"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#C5A059" />

        <!-- منطقة النتيجة وأزرار الحفظ والمشاركة -->
        <LinearLayout
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnCopyDraft"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="📋 نسخ النص"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#2E7D32" />

                <Button
                    android:id="@+id/btnShareDraft"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="📤 مشاركة"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#1976D2" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المسودة الجاهزة:"
                    android:textColor="#0F2042"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDraftResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="10"
                android:gravity="top|right"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:padding="12dp"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
