<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#E0E6ED"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- الرأس: موضوع الدعوى وحالتها -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCaseStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="قيد النظر"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#0F2042"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tvCaseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="موضوع الدعوى"
                android:textColor="#0F2042"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="right" />
        </LinearLayout>

        <!-- المحكمة ورقم الأساس -->
        <TextView
            android:id="@+id/tvCaseCourtAndBasis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚖️ المحكمة: - | أساس: -"
            android:textColor="#37474F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="right" />

        <!-- أطراف الدعوى: الموكل ضد الخصم -->
        <TextView
            android:id="@+id/tvParties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👤 الموكل: - ضد: -"
            android:textColor="#546E7A"
            android:textSize="13sp"
            android:gravity="right" />

        <!-- بطاقة موعد الجلسة القادمة -->
        <LinearLayout
            android:id="@+id/layoutNextSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF9C4"
            android:padding="8dp"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:id="@+id/tvNextSessionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 الجلسة القادمة: -"
                android:textColor="#B78103"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="right" />

            <TextView
                android:id="@+id/tvNextSessionRequired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="المطلوب: -"
                android:textColor="#5D4037"
                android:textSize="12sp"
                android:gravity="right" />
        </LinearLayout>

        <!-- شريط إجراءات التواصل السريع مع الموكل -->
        <LinearLayout
            android:id="@+id/layoutClientActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="left|center_vertical">

            <Button
                android:id="@+id/btnCallClient"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📞 اتصال"
                android:textSize="12sp"
                android:textColor="#1976D2"
                android:padding="0dp"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnWhatsAppClient"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:text="💬 واتساب"
                android:textSize="12sp"
                android:textColor="#2E7D32"
                android:padding="0dp"
                android:minWidth="0dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تاريخ القيد: -"
                android:textColor="#9E9E9E"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
