<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="حجرة المالك - توليد كود تفعيل"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etTargetDeviceId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="معرّف جهاز المستخدم"
        android:textColor="#000000"
        android:textColorHint="#555555"
        android:layout_marginBottom="12dp" />

    <Spinner
        android:id="@+id/spinnerDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnGenerateCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="توليد كود التفعيل" />

    <TextView
        android:id="@+id/tvResultCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />
    <Button
        android:id="@+id/btnCopyCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="نسخ الكود"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnExitOwnerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="خروج"
        android:layout_marginTop="40dp"
        android:backgroundTint="#D32F2F" />

</LinearLayout>
