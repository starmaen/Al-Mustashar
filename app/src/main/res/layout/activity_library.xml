<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:layoutDirection="rtl">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0F2042"
        app:title="📚 المكتبة القانونية"
        app:titleTextColor="#FFFFFF" />

    <HorizontalScrollView
        android:id="@+id/sectionChipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0F2042"
                android:text="الكل 📚"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipRef"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2E8F0"
                android:text="مراجع قانونية"
                android:textColor="#0F2042"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipLaws"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2E8F0"
                android:text="قوانين واتفاقات دولية"
                android:textColor="#0F2042"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipCases"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2E8F0"
                android:text="اجتهادات قضائية"
                android:textColor="#0F2042"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipMisc"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#E2E8F0"
                android:text="كتب منوعة"
                android:textColor="#0F2042"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="3dp">

        <EditText
            android:id="@+id/etLibrarySearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="ابحث في المكتبة حصراً..."
            android:paddingHorizontal="12dp"
            android:textColor="#0F2042"
            android:textColorHint="#94A3B8"
            android:textSize="13sp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btnLibrarySearch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0F2042"
            android:text="بحث 🔍"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnLibraryAsk"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#5E35B1"
            android:text="اسأل 🤖"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/libraryProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvLibraryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="اختر مرجعاً من القائمة، أو ابحث واسأل ضمن المكتبة حصراً."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- قائمة المراجع القابلة للطي والفتح -->
    <ExpandableListView
        android:id="@+id/expLibrary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:groupIndicator="@android:drawable/arrow_down_float"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibraryResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/tvLibraryResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/libraryNavRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnLibraryPrev"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#334155"
                    android:text="⏮ السابق"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvLibraryPosition"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#0F2042"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnLibraryNext"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#334155"
                    android:text="التالي ⏭"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnLibraryCopy"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#0F2042"
                    android:text="📋 نسخ"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnLibraryShare"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D97706"
                    android:text="📤 مشاركة"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
