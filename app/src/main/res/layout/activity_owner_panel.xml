<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#ECEFF1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لوحة تحكم المالك — توليد التراخيص"
            android:textColor="#263238"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etCustomerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="اسم الزبون / المستخدم"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etCustomerDeviceId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="معرف جهاز الزبون (Device ID)"
            android:fontFamily="monospace"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="رقم الهاتف / الواتساب"
            android:inputType="phone"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbGifted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎁 ترخيص مجاني كهدية"
            android:textColor="#212121"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مدة الترخيص:"
            android:textColor="#37474F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="شهر" />

            <RadioButton
                android:id="@+id/rbYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="سنة" />

            <RadioButton
                android:id="@+id/rbLifetime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="دائم" />
        </RadioGroup>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="توليد كود التفعيل وأرشفته"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A237E"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="كود التفعيل المتولد:"
                android:textColor="#4527A0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGeneratedCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="---"
                android:textColor="#1A237E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyCode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="نسخ الكود"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#5E35B1" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btnShareCode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="مشاركة واتساب"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2E7D32" />
            </LinearLayout>
        </LinearLayout>

        <!-- أرشيف المرخصين: مرتبط بالتوليد أعلاه -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="📋 أرشيف المرخصين"
            android:textColor="#263238"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSearchLicenses"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="🔍 بحث بالاسم أو الهاتف أو الكود..."
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLicensesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لا مرخصين بعد — ولّد أول ترخيص أعلاه."
            android:textColor="#757575"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutLicensesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
