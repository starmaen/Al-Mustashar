<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/layoutSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:hint="ابحث في القوانين أو تابع السؤال..."
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:background="@android:drawable/editbox_background"
            android:backgroundTint="#1E293B"
            android:padding="10dp"
            android:gravity="right|top"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="بحث"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/searchProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_margin="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:gravity="right"
            android:textDirection="rtl" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnFallbackGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بحث في مراجع Google القانونية"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
