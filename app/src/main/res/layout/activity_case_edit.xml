<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="⚖️ إضافة ملف دعوى جديد"
            android:textColor="#0F2042"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="right" />

        <!-- القسم الأول: بيانات الدعوى والمحكمة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بيانات المحكمة والأساس"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="موضوع الدعوى * (مثال: تثبيت بيع عقار، طلاق للشقاق)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etCaseYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="سنة الدعوى (مثال: 2026)"
                android:inputType="number"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>

            <EditText
                android:id="@+id/etBasisNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="رقم الأساس (مثال: 1420)"
                android:inputType="number"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etChamber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="الغرفة (الأولى، الثانية...)"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>

            <EditText
                android:id="@+id/etCourt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="المحكمة (بداية، صلح، استئناف...)"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etJudgeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="اسم القاضي / الهيئة الحاكمة"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right"/>

        <!-- القسم الثاني: أطراف الخصومة والاتصال -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أطراف الخصومة والاتصال"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etClientRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="صفة الموكل (مدعٍ / مدعى عليه)"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>

            <EditText
                android:id="@+id/etClient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:layout_marginStart="8dp"
                android:hint="اسم الموكل *"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="رقم هاتف الموكل (للاتصال والواتساب السريع)"
            android:inputType="phone"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etOpponentLawyer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="محامي الخصم"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>

            <EditText
                android:id="@+id/etOpponentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="اسم الخصم"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>
        </LinearLayout>

        <!-- بند الشهود والإثبات -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 قائمة الشهود والبينات الشخصية"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <EditText
            android:id="@+id/etWitnesses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="سجل الشهود: الأسماء، صفتهم (شهود إثبات/نفي)، موضوع الشهادة..."
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"/>

        <!-- القسم الثالث: التواريخ والجلسة القادمة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إدارة الجلسات والمواعيد"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etNextSessionDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="false"
                android:clickable="true"
                android:hint="📅 موعد الجلسة القادمة"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>

            <EditText
                android:id="@+id/etDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:clickable="true"
                android:hint="📅 تاريخ افتتاح الدعوى"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:gravity="right"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etLastSessionDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="ما تقرر في الجلسة السابقة (القرار التمهيدي)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right"/>

        <EditText
            android:id="@+id/etNextSessionRequired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="المطلوب في الجلسة القادمة (مذكرة، إبراز، استجواب...)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right"/>

        <!-- القسم الرابع: تفاصيل ودفوع الدعوى -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وقائع ودفوع الدعوى والقرار"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <EditText
            android:id="@+id/etSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|right"
            android:hint="ملخص ووقائع الدعوى والأسانيد القانونية"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"/>

        <EditText
            android:id="@+id/etSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="سجل الجلسات السابقة والملاحظات المتراكمة"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"/>

        <EditText
            android:id="@+id/etProcedures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="الإجراءات المتخذة وملاحظات المحامي السرية"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"/>

        <EditText
            android:id="@+id/etStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="حالة الدعوى (قيد النظر / محكومة / قيد التنفيذ / مشطوبة)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:gravity="right"/>

        <EditText
            android:id="@+id/etFinalJudgment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="منطوق القرار النهائي وحيثيات الحكم (إن صدر)"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"/>

        <!-- القسم الخامس: المرفقات والمستندات المؤرشفة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📎 الوثائق والمرفقات المؤرشفة (صور / PDF / مستندات)"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="right"/>

        <Button
            android:id="@+id/btnAddDocument"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="➕ إضافة مرفق (PDF / صورة / مستند)"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <LinearLayout
            android:id="@+id/layoutDocumentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnCloudBackup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="☁️ نسخ المرفقات إلى Google Drive (مساحتك الخاصة)"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5E35B1" />

        <!-- أزرار الإجراءات والمذكرات الذكية -->
        <Button
            android:id="@+id/btnDraftForCase"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="✍️ صياغة مذكرة أو استدعاء ذكي لهذه القضية"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1976D2"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDecisions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="⚖️ قرارات وأحكام الدعوى"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#C5A059"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="حفظ ملف الدعوى"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F2042" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="حذف الدعوى نهائياً"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
