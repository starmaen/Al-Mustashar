<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✍️ استوديو الصياغة العامة"
            android:textColor="#0F2042"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="مذكرات وطعون واستشارات وطلبات — عنوان ونوع ومرفقات وتنسيق وحفظ"
            android:textColor="#757575"
            android:textSize="12sp"
            android:gravity="right" />

        <!-- 0. عنوان المذكرة ونوع المستند -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0️⃣ عنوان المذكرة ونوع المستند:"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etDraftTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="عنوان المذكرة (مثال: مذكرة جوابية في الدعوى أساس 123)"
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp"
            android:gravity="right" />

        <Spinner
            android:id="@+id/spinnerDocType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:paddingStart="10dp"
            android:gravity="right" />

        <!-- 1. ترويسة ومقدمة المذكرة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1️⃣ ترويسة ومقدمة المذكرة:"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etCustomHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="3"
            android:gravity="top|right"
            android:hint="إلى السيد قاضي... المحترم
المستدعي / الجهة المدعية: ... بصفتي وكيلاً...
الجهة المدعى عليها: ...
الدعوى أساس: ..."
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <!-- 2. المطلوب والوقائع -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2️⃣ المطلوب والوقائع (للصياغة بالذكاء الاصطناعي):"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etFactsAndDemands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="4"
            android:gravity="top|right"
            android:hint="اكتب المطلوب إنشاؤه والوقائع (مثال: صياغة طعن استئنافي بحكم...، أو استشارة حول...)"
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnTemplates"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📑 قوالب جاهزة"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#5E35B1" />

            <Button
                android:id="@+id/btnAttachImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="📎 صورة مستند"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#0F2042" />

            <Button
                android:id="@+id/btnAttachText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="📝 ملف نصي"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#455A64" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAttachmentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="لا توجد مرفقات"
            android:textColor="#757575"
            android:textSize="11sp"
            android:gravity="right" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnImportCase"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="⚖️ استيراد من دعوى"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#6A1B9A" />

            <Button
                android:id="@+id/btnGroundLaws"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📖 تأريض بالمواد"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#00796B" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGroundStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="التأريض: يدوي"
            android:textColor="#757575"
            android:textSize="11sp"
            android:gravity="right" />

        <!-- 2ب. ملاحظات التنسيق -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2️⃣ب ملاحظات التنسيق (اختياري):"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etTargetLines"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="عدد الأسطر (مثال: 40)"
                android:inputType="number"
                android:padding="8dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:textSize="12sp"
                android:gravity="right" />

            <Button
                android:id="@+id/btnFontSmaller"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="−A"
                android:textSize="14sp"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFontBigger"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="+A"
                android:textSize="14sp"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnFontColor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🎨 لون الخط"
                android:textSize="12sp"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 3. الخاتمة والتوقيع -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3️⃣ الخاتمة والتوقيع:"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etCustomFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="بكل تحفظ واحترام
الوكيل المحامي: ..."
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <!-- شريط التقدم وزر الصياغة -->
        <ProgressBar
            android:id="@+id/progressDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGenerateDraft"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="✨ توليد وإنشاء المذكرة الآن"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#0F2042" />

        <!-- الناتج المدمج النهائي -->
        <LinearLayout
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="المذكرة النهائية الجاهزة:"
                android:textColor="#C5A059"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="right" />

            <EditText
                android:id="@+id/etDraftResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="12"
                android:gravity="top|right"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:padding="12dp"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnCopyDraft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📋 نسخ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#2E7D32" />

                <Button
                    android:id="@+id/btnShareDraft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="📤 مشاركة"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#1976D2" />

                <Button
                    android:id="@+id/btnSaveDraft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="💾 حفظ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#6A1B9A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnExportDraft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📥 تصدير (TXT)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#00796B" />

                <Button
                    android:id="@+id/btnPrintDraft"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="🖨️ طباعة"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#455A64" />

                <Button
                    android:id="@+id/btnMyDrafts"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="📚 مسوداتي"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#C5A059" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
