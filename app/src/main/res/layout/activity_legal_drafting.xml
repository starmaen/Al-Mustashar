<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ صائغ المذكرات والاستدعاءات القضائية"
            android:textColor="#0F2042"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="مقدمة المحامي + صلب المذكرة بالذكاء الاصطناعي + خاتمة وتوقيع"
            android:textColor="#757575"
            android:textSize="12sp"
            android:gravity="right" />

        <!-- 1. ترويسة ومقدمة المذكرة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1️⃣ ترويسة ومقدمة المذكرة (تخصيص المحامي):"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etCustomHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="3"
            android:gravity="top|right"
            android:hint="إلى السيد قاضي... المحترم
المستدعي / الجهة المدعية: ... بصفتي وكيلاً...
الجهة المدعى عليها: ...
الدعوى أساس: ..."
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <!-- 2. صلب الموضوع والوقائع -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2️⃣ موضوع ووقائع المذكرة (للصياغة بالذكاء الاصطناعي):"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etFactsAndDemands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="4"
            android:gravity="top|right"
            android:hint="اكتب الغرض والوقائع المطلوبة (مثال: طلب مهلة للاطلاع وإبراز حجة حصر إرث وسند تمليك، أو رد الدفع بالتقادم)..."
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <!-- إرفاق صورة مستند إن وجد -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnAttachImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📎 إرفاق مستند/سند"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#0F2042" />

            <TextView
                android:id="@+id/tvAttachmentStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="لا توجد مرفقات"
                android:textColor="#757575"
                android:textSize="11sp"
                android:gravity="right" />
        </LinearLayout>

        <!-- 3. الخاتمة والتوقيع -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3️⃣ الخاتمة والتوقيع (تخصيص المحامي):"
            android:textColor="#C5A059"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/etCustomFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minLines="2"
            android:gravity="top|right"
            android:hint="بكل تحفظ واحترام
الوكيل المحامي: ..."
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#0F2042"
            android:textSize="13sp" />

        <!-- شريط التقدم وزر الصياغة -->
        <ProgressBar
            android:id="@+id/progressDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGenerateDraft"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="✨ صياغة ودمج المذكرة القضائية الآن"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#0F2042" />

        <!-- الناتج المدمج النهائي -->
        <LinearLayout
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnCopyDraft"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="📋 نسخ النص الكامل"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#2E7D32" />

                <Button
                    android:id="@+id/btnShareDraft"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="📤 مشاركة"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:backgroundTint="#1976D2" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المذكرة النهائية الجاهزة:"
                    android:textColor="#C5A059"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDraftResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="12"
                android:gravity="top|right"
                android:background="@android:drawable/edit_text"
                android:textColor="#0F2042"
                android:padding="12dp"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
